---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="h-screen flex flex-col">
    <Header />
    <div class="absolute top-12 left-0 -z-10" id="quil-sketch"></div>
    <main
      class="text-slate-800 m-auto w-full px-8 mt-24 md:mt-60 grid grid-cols-[1.2fr_min(60ch,_95%)_1fr]"
    >
      <h1 class="col-[2] text-4xl">Hi there!</h1>
      <p class="col-[2] mt-4">
        I’m Jeremy Dormitzer. I’m a full-stack software engineer from Boston,
        MA.
      </p>
      <p class="col-[2] mt-4">
        I love generative art, entrepreneurship, and automation. I think that
        software gives us superpowers, and I want to build programs that
        suprise, delight, and empower.
      </p>
      <p class="col-[2] mt-4">
        Connect with me on
        <a href="https://twitter.com/jeremydormitzer">Twitter</a> or
        <a href="https://linkedin.com/in/jeremydormitzer">LinkedIn</a>.
      </p>
    </main>
    <Footer />
  </body>
</html>

<script is:inline src="/cljs/main.js"></script>
